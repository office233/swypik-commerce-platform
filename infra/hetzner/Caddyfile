# ============================================================
# Swypik Production — Caddy Reverse Proxy Configuration
# HTTPS is automatic via Let's Encrypt (ACME).
# ============================================================

# Global options
{
	email admin@swypik.com
	# Staging CA for testing — remove for production:
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# -------------------------------------------------------
# Main storefront — swypik.com
# -------------------------------------------------------
swypik.com {
	# Security headers
	header {
		X-Frame-Options            "DENY"
		X-Content-Type-Options     "nosniff"
		Referrer-Policy            "strict-origin-when-cross-origin"
		Strict-Transport-Security  "max-age=63072000; includeSubDomains; preload"
		# X-XSS-Protection eliminat (deprecated; modern browsers ignoră,
		# IE legacy + Edge pre-Chromium pot introduce noi vulnerabilități cf. OWASP 2024).
		# CSP frame-ancestors 'none' + X-Frame-Options DENY rămân protecția anti-XSS reală.
		-X-XSS-Protection
		# x-middleware-rewrite leakează rutarea internă Next (ex. "/en") către
		# client. Scos defensiv aici (2026-06-19, P0 #10) — nu schimbă comportamentul,
		# doar elimină semnalul exploatabil pentru fingerprinting.
		-X-Middleware-Rewrite
		# Permissions-Policy mai strict (2026-06-19, P0 #10). Closed-by-default:
		# tot ce nu folosim activ este =() ca să blocăm orice iframe-injection vector.
		# camera + microphone rămân (self) — record + AI chat le folosesc.
		# fullscreen + clipboard-read rămân (self) — UI video + share button.
		Permissions-Policy         "accelerometer=(), autoplay=(self), browsing-topics=(), camera=(self), clipboard-read=(self), clipboard-write=(self), display-capture=(), fullscreen=(self), geolocation=(), gyroscope=(), interest-cohort=(), magnetometer=(), microphone=(self), midi=(), payment=(self \"https://js.stripe.com\" \"https://checkout.stripe.com\"), picture-in-picture=(self), publickey-credentials-get=(self), screen-wake-lock=(self), serial=(), usb=(), web-share=(self), xr-spatial-tracking=()"
		# Cross-Origin isolation (best-effort; same-origin pentru izolare totală)
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		Cross-Origin-Resource-Policy "same-origin"
		# Remove server identity
		-Server
	}

	# Gzip / zstd compression
	encode zstd gzip

	# Logging
	log {
		output file /var/log/caddy/access.log {
			roll_size 100MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}

	# DISABLED 2026-05-17 — mediamtx în profile:disabled; reactivează când e nevoie de RTMP live
	# handle_path /hls/* {
	#	reverse_proxy mediamtx:8888
	# }

	# Next.js static assets — long cache (Cache-Control set by Next, no dup here)
	handle /_next/static/* {
		reverse_proxy web-next:3000 {
			lb_try_duration 10s
			lb_try_interval 250ms
			fail_duration 5s
			max_fails 3
		}
	}

	# Next.js data / image optimisation routes
	handle /_next/* {
		reverse_proxy web-next:3000 {
			lb_try_duration 10s
			lb_try_interval 250ms
			fail_duration 5s
			max_fails 3
		}
	}

	# API routes served by the Next.js backend (BFF)
	handle /api/* {
		reverse_proxy web-next:3000 {
			lb_try_duration 10s
			lb_try_interval 250ms
			fail_duration 5s
			max_fails 3
		}
	}

	# Same-origin media proxy for HLS/video assets. R2 public domain does not
	# expose CORS headers with the current bucket key, so the feed reads via /media.
	handle_path /media/* {
		header Access-Control-Allow-Origin "https://swypik.com"
		header Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
		header Access-Control-Allow-Headers "Range, Content-Type"
		header Access-Control-Expose-Headers "Content-Length, Content-Range, Accept-Ranges, ETag"
		header Cache-Control "public, max-age=31536000, immutable"
		header CDN-Cache-Control "public, max-age=31536000"
		reverse_proxy https://media.swypik.com {
			header_up Host media.swypik.com
		}
	}

	# Everything else → Next.js SSR
	handle {
		reverse_proxy web-next:3000 {
			lb_try_duration 10s
			lb_try_interval 250ms
			fail_duration 5s
			max_fails 3
		}
	}
}

# -------------------------------------------------------
# Platform API — api.swypik.com  (Go service)
# -------------------------------------------------------
api.swypik.com {
	# Security headers
	header {
		X-Frame-Options            "DENY"
		X-Content-Type-Options     "nosniff"
		Referrer-Policy            "no-referrer"
		Strict-Transport-Security  "max-age=63072000; includeSubDomains; preload"
		-X-XSS-Protection
		Permissions-Policy         "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy    "default-src 'none'; frame-ancestors 'none'"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
	}

	encode zstd gzip

	log {
		output file /var/log/caddy/api-access.log {
			roll_size 100MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}

	# CORS preflight — adjust origins as needed
	@cors_preflight method OPTIONS
	handle @cors_preflight {
		header Access-Control-Allow-Origin  "https://swypik.com"
		header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
		header Access-Control-Allow-Headers "Authorization, Content-Type"
		header Access-Control-Max-Age       "86400"
		respond "" 204
	}

	# All traffic → Go API
	reverse_proxy platform-api:8080 {
		lb_try_duration 10s
		lb_try_interval 250ms
		fail_duration 5s
		max_fails 3
	}
}

# -------------------------------------------------------
# Pi Network app — pi.swypik.com  (Pi-only experience)
# Middleware rewrites all non-/api traffic on this host to /pi.
# -------------------------------------------------------
pi.swypik.com {
	header {
		X-Content-Type-Options     "nosniff"
		Referrer-Policy            "strict-origin-when-cross-origin"
		Strict-Transport-Security  "max-age=63072000; includeSubDomains; preload"
		-X-XSS-Protection
		-X-Middleware-Rewrite
		-Server
		# Pi Browser loads the app inside its own webview and needs the Pi SDK.
		# Allow the SDK origin for scripts + connections; everything else stays
		# locked down. frame-ancestors permits Pi's app shell to host us.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://sdk.minepi.com; connect-src 'self' https://swypik.com https://api.minepi.com https://sdk.minepi.com; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; frame-ancestors https://*.minepi.com https://app-cdn.minepi.com"
		Permissions-Policy "payment=(self \"https://sdk.minepi.com\"), camera=(), microphone=(), geolocation=()"
	}

	encode zstd gzip

	log {
		output file /var/log/caddy/pi-access.log {
			roll_size 100MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}

	# Static + API + media share the same Next backend.
	handle /_next/* {
		reverse_proxy web-next:3000 {
			lb_try_duration 10s
			lb_try_interval 250ms
			fail_duration 5s
			max_fails 3
		}
	}
	handle /api/* {
		reverse_proxy web-next:3000 {
			lb_try_duration 10s
			lb_try_interval 250ms
			fail_duration 5s
			max_fails 3
		}
	}
	handle_path /media/* {
		header Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy https://media.swypik.com {
			header_up Host media.swypik.com
		}
	}
	handle {
		reverse_proxy web-next:3000 {
			lb_try_duration 10s
			lb_try_interval 250ms
			fail_duration 5s
			max_fails 3
		}
	}
}

# -------------------------------------------------------
# www.swypik.com → swypik.com (301)
# -------------------------------------------------------
www.swypik.com {
	redir https://swypik.com{uri} 301
}
# -------------------------------------------------------
