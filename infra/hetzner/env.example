# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║                    SWYPIK PRODUCTION ENVIRONMENT                           ║
# ║                                                                            ║
# ║  Copiază acest fișier ca .env și completează toate valorile CHANGE_ME      ║
# ║  cp env.example .env && nano .env                                          ║
# ║                                                                            ║
# ║  ⚠  NU comite fișierul .env în Git!                                        ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ═══════════════════════════════════════════════════════════════════════════════
# DATABASE (PostgreSQL 16)
# ═══════════════════════════════════════════════════════════════════════════════
# Connection string folosit de Next.js și Go API pentru conectarea la PostgreSQL.
# Hostname-ul "postgres" corespunde numelui serviciului din docker-compose.prod.yml.
# sslmode=disable deoarece comunicarea se face intern în rețeaua Docker.
# nosemgrep: trailofbits.generic.postgres-insecure-sslmode.postgres-insecure-sslmode - example uses Docker-internal Postgres without TLS; production edge traffic is TLS-terminated by Caddy.
DATABASE_URL=postgresql://swypik:CHANGE_ME@postgres:5432/swypik_prod?sslmode=disable

# Credențiale folosite de containerul PostgreSQL la inițializare.
# POSTGRES_PASSWORD trebuie să fie identică cu cea din DATABASE_URL.
POSTGRES_DB=swypik_prod
POSTGRES_USER=swypik
POSTGRES_PASSWORD=CHANGE_ME

# ═══════════════════════════════════════════════════════════════════════════════
# REDIS 7
# ═══════════════════════════════════════════════════════════════════════════════
# Folosit pentru caching, rate-limiting și cozi de job-uri.
# Hostname-ul "redis" corespunde numelui serviciului din docker-compose.prod.yml.
# nosemgrep: trailofbits.generic.redis-unencrypted-transport.redis-unencrypted-transport - example uses Docker-internal Redis without TLS; do not expose Redis publicly.
REDIS_URL=redis://redis:6379
REDIS_STREAM_EVENTS=social.events
REDIS_STREAM_VIDEO_JOBS=video:jobs
VIDEO_QUEUE_NAME=video:jobs

# ═══════════════════════════════════════════════════════════════════════════════
# NEXT.JS (Storefront)
# ═══════════════════════════════════════════════════════════════════════════════
# URL-ul public al aplicației — folosit pentru generarea link-urilor absolute,
# meta tags, OG images și callback-uri OAuth/Stripe.
NEXT_PUBLIC_APP_URL=https://swypik.com
NEXT_PUBLIC_ADMIN_CREATOR_ID=00000000-0000-4000-8000-000000000001

# Setează modul de execuție Node.js. Întotdeauna "production" pe server.
NODE_ENV=production

# ═══════════════════════════════════════════════════════════════════════════════
# STRIPE (Plăți)
# ═══════════════════════════════════════════════════════════════════════════════
# Cheia secretă Stripe — folosită server-side pentru crearea sesiunilor de checkout,
# procesarea refund-urilor și gestionarea subscripțiilor.
# Găsești în: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=CHANGE_ME

# Secret-ul webhook-ului Stripe — verifică semnătura evenimentelor primite.
# Configurează webhook-ul în: https://dashboard.stripe.com/webhooks
# Endpoint: https://swypik.com/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# Cheia publică Stripe — folosită client-side pentru Stripe.js / Elements.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_CHANGE_ME

# ═══════════════════════════════════════════════════════════════════════════════
# EMAIL (Resend)
# ═══════════════════════════════════════════════════════════════════════════════
# API key Resend — folosit pentru trimiterea email-urilor tranzacționale
# (confirmări comenzi, resetare parolă, notificări expediere).
# Obține de la: https://resend.com/api-keys
RESEND_API_KEY=re_CHANGE_ME

# Adresa expeditorului — domeniul trebuie verificat în dashboard-ul Resend.
EMAIL_FROM=Swypik <noreply@swypik.com>

# ═══════════════════════════════════════════════════════════════════════════════
# AUTH / SECRETS
# ═══════════════════════════════════════════════════════════════════════════════
# Generează fiecare secret cu: openssl rand -hex 32
# Aceste secrete protejează endpoint-urile interne și webhook-urile.

# Secret pentru accesul la panoul de administrare (/admin).
ADMIN_SECRET=CHANGE_ME_64_CHAR_HEX

# Secret folosit de cron-worker pentru a apela endpoint-urile de mentenanță.
# Previne execuția neautorizată a job-urilor periodice.
CRON_SECRET=CHANGE_ME_64_CHAR_HEX

# Secret pentru endpoint-ul de import produse în bulk.
# Protejează împotriva importurilor neautorizate în catalog.
IMPORT_SECRET=CHANGE_ME_64_CHAR_HEX

# Secret pentru autentificarea webhook-urilor de la furnizori (status comenzi).
# Verifică header-ul X-Webhook-Secret la fiecare request primit.
SUPPLIER_WEBHOOK_SECRET=CHANGE_ME_64_CHAR_HEX

# Shared secret used by Next.js to call the internal Go API. Generate with openssl rand -hex 32.
PLATFORM_API_SECRET=CHANGE_ME_64_CHAR_HEX

# In production, missing Upstash Redis rate limiting fails closed by default.
# Set to false only for a known single-node deployment that accepts in-memory rate limits.
RATE_LIMIT_REDIS_REQUIRED=true

# ═══════════════════════════════════════════════════════════════════════════════
# CLOUDFLARE R2 STORAGE
# ═══════════════════════════════════════════════════════════════════════════════
# Stocare S3-compatibilă pentru imagini produse, video-uri și media.
# Configurează în: https://dash.cloudflare.com → R2

# Endpoint-ul API — înlocuiește ACCOUNT_ID cu ID-ul contului Cloudflare.
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com

# Numele bucket-ului R2 creat în dashboard.
S3_BUCKET=swypik-media-prod
S3_MEDIA_BUCKET=swypik-media-prod

# Credențiale API token R2 (crează din Settings → R2 API Tokens).
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME

# URL-ul public pentru servirea media — configurează un Custom Domain pe bucket.
# Exemplu: CNAME media.swypik.com → bucket-ul R2 public.
S3_PUBLIC_URL=https://media.swypik.com
S3_PUBLIC_BASE_URL=https://media.swypik.com
PUBLIC_UPLOAD_BASE_URL=https://media.swypik.com
S3_REGION=auto
S3_FORCE_PATH_STYLE=true

# ═══════════════════════════════════════════════════════════════════════════════
# GO API (Platform Video Service)
# ═══════════════════════════════════════════════════════════════════════════════
# URL-ul intern al API-ului Go pentru upload-ul video-urilor.
# "platform-api" este numele serviciului din docker-compose.prod.yml.
GO_API_URL=http://platform-api:8080

# Runtime mode for the Go platform API.
ENVIRONMENT=production

# ═══════════════════════════════════════════════════════════════════════════════
# AI / GEMINI
# ═══════════════════════════════════════════════════════════════════════════════
# API key Google Gemini — folosit pentru generarea descrierilor de produse,
# tag-uri automate și procesarea conținutului AI.
# Obține de la: https://aistudio.google.com/apikey
GEMINI_API_KEY=CHANGE_ME

# ═══════════════════════════════════════════════════════════════════════════════
# VISION24 (newsroom AI separat, /opt/vision24)
# ═══════════════════════════════════════════════════════════════════════════════
# 1 → activează carduri Vision24 (news + news_video + fact_check) în feed Explore
VISION24_FEED_ENABLED=1
# URL intern Docker (rețeaua swypik-prod_default)
VISION24_API_URL=http://vision24-api:4000
# Ratio per tip card (din feedLimit); cap dur via VISION24_MAX_RATIO
VISION24_VIDEO_RATIO=0.12
VISION24_NEWS_RATIO=0.05
VISION24_FACT_RATIO=0.03
VISION24_MAX_RATIO=0.20
