[Unit]
Description=Swypik AliExpress Bulk Import Worker
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/swypik/app
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/swypik/app/scripts/ae-bulk-import-worker.mjs --qps=2
Restart=on-failure
RestartSec=15
StandardOutput=append:/opt/swypik/logs/ae-import.stdout.log
StandardError=append:/opt/swypik/logs/ae-import.stderr.log
TimeoutStopSec=60
KillSignal=SIGTERM

# Resource limits
MemoryHigh=512M
MemoryMax=1G

[Install]
WantedBy=multi-user.target
