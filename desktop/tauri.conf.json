{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Swypik Business ERP",
  "version": "1.0.0",
  "identifier": "com.swypik.business.erp",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000/seller"
  },
  "app": {
    "windows": [
      {
        "title": "Swypik Business ERP - Nod Local",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": {
        "language": [
          "ro-RO",
          "en-US"
        ]
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/header.bmp",
        "sidebarImage": "icons/sidebar.bmp"
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": "icons/dmg-bg.png",
        "windowSize": {
          "width": 600,
          "height": 400
        }
      }
    }
  }
}
