# Local social marketplace stack
POSTGRES_DB=swypik_social
POSTGRES_USER=swypik
POSTGRES_PASSWORD=swypik_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://swypik:swypik_dev_password@localhost:5432/swypik_social

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
REDIS_STREAM_EVENTS=social.events
REDIS_STREAM_VIDEO_JOBS=social.video.jobs
REDIS_STREAM_ANALYTICS=social.analytics

# Optional search profile: docker compose --profile search ...
OPENSEARCH_PORT=9200
OPENSEARCH_URL=http://localhost:9200

CLICKHOUSE_DB=social_analytics
CLICKHOUSE_USER=swypik
CLICKHOUSE_PASSWORD=swypik_dev_password
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9002
CLICKHOUSE_METRICS_PORT=9363
CLICKHOUSE_URL=http://localhost:8123

MINIO_ROOT_USER=swypik
MINIO_ROOT_PASSWORD=swypik_dev_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
SOCIAL_MEDIA_BUCKET=social-media
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=swypik
S3_SECRET_ACCESS_KEY=swypik_dev_password
S3_FORCE_PATH_STYLE=true

POSTGRES_EXPORTER_PORT=9187
REDIS_EXPORTER_PORT=9121
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=7d
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=swypik_dev_password

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_PLATFORM_FEE_BPS=1000

# Go platform API
HOST=0.0.0.0
PORT=8080
ENVIRONMENT=development
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
PUBLIC_UPLOAD_BASE_URL=http://localhost:9000/social-media
UPLOAD_TTL_MINUTES=15
S3_MEDIA_BUCKET=social-media

# Production R2 shape, left blank intentionally.
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
