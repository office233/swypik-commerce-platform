/**
 * Product Queries — Reads from final marketplace_products architecture
 */

import { dbQuery } from "@/lib/db";

function cleanCategoryLabel(value: unknown, fallback = "General") {
  const label = String(value || "").trim();
  if (!label || /^AE-\d+$/i.test(label)) return fallback;
  return label;
}

// ─── Transform DB row → frontend Product ──────────────────────────────
function transformProduct(row: any) {
  const rawPriceCents = Number(row.price_cents);
  const hasValidPrice = Number.isFinite(rawPriceCents) && rawPriceCents > 0;
  const price = hasValidPrice ? rawPriceCents / 100 : 29; // fallback
  const oldPriceCents = Number(row.compare_at_price_cents) || 0;
  const oldPrice = oldPriceCents > 0 ? oldPriceCents / 100 : Math.round(price * 1.5);
  const discountPercent = oldPrice > price ? Math.round(((oldPrice - price) / oldPrice) * 100) : 0;

  const metadata = row.metadata || {};
  const seed = Math.abs(hashCode(`mp_${row.id}`));
  
  const hasRealOrders = metadata.orders_count != null && Number(metadata.orders_count) > 0;
  const hasRealRating = metadata.rating != null && Number(metadata.rating) > 0;

  const orders = hasRealOrders ? Number(metadata.orders_count) : (38 + (seed % 380));
  const rating = hasRealRating
    ? Number(Number(metadata.rating).toFixed(1))
    : Number(Math.min(5, Math.max(4.3, 4.45 + ((seed % 45) / 100))).toFixed(1));
  
  const deliveryDays = metadata.ship_days_min || (2 + (seed % 4));
  const viewers = 7 + (seed % 25);
  const cartAdds = Math.max(3, Math.round(orders * 0.14));

  // Build images array
  const images: string[] = [];
  if (row.image_url) images.push(row.image_url);
  if (metadata.images && Array.isArray(metadata.images)) {
    images.push(...metadata.images.filter((img: string) => img && img !== row.image_url).slice(0, 5));
  }

  // Social proof labels
  const socialProofLabel = hasRealOrders && orders > 500
    ? `${orders}+ comenzi`
    : hasRealOrders && orders > 100
      ? `${orders}+ vândute`
      : hasRealOrders && orders > 10
        ? `Popular`
        : undefined;

  const commerceBadge = hasRealOrders && orders > 500 ? "🔥 Se vinde bine"
    : hasRealRating && rating >= 4.8 && hasRealOrders && orders > 100 ? "⭐ Alegere sigură"
    : discountPercent >= 30 ? "💰 Super reducere"
    : undefined;

  return {
    id: String(row.id),
    aeProductId: String(row.supplier_product_id || row.external_product_id),
    title: row.title,
    titleEn: row.title, // keeping title for backwards compat
    description: row.description ? row.description.replace(/<[^>]*>/g, " ").trim().substring(0, 200) : row.title,
    benefits: ["Livrare rapidă în România", "Checkout securizat", "Produs verificat"],
    whyBuy: "",
    warnings: [] as string[],
    price,
    oldPrice,
    discountPercent,
    costUsd: metadata.ship_cost_usd || 0,
    rating,
    orders,
    deliveryDays,
    viewers,
    cartAdds,
    isEstimatedSocial: !hasRealOrders,
    hasValidPrice,
    images,
    video: metadata.video_url || null,
    hasVideo: metadata.has_video || false,
    category: cleanCategoryLabel(row.category, "General"),
    categoryId: 0,
    vendor: metadata.store_name || row.brand || "Swypik",
    tags: cleanCategoryLabel(row.category, ""),
    gradient: "from-orange-500 to-pink-500",
    qualityScore: Math.min(10, Math.max(7, Math.round(rating * 2))),
    shipFree: metadata.ship_cost_usd === 0,
    shipMethod: "",
    shipDaysMin: metadata.ship_days_min,
    shipDaysMax: metadata.ship_days_max,
    socialProofLabel,
    commerceBadge,
    dealLabel: discountPercent >= 20 ? "🔥 Super Deal" : discountPercent >= 10 ? "💰 Preț bun" : "✨ Nou",
    variantsCount: 0, // could fetch if needed
  };
}

function hashCode(s: string): number {
  let h = 0;
  for (let i = 0; i < s.length; i++) h = ((h << 5) - h + s.charCodeAt(i)) | 0;
  return Math.abs(h);
}

// ─── Search Products ──────────────────────────────────────────────
export type ProductFilters = {
  search?: string;
  category?: string;
  minPrice?: number;
  maxPrice?: number;
  sort?: "price_asc" | "price_desc" | "popular" | "newest" | "discount";
  mode?: "trending" | "feed" | "deals" | "default" | "video" | "bestvalue" | "toprated";
  limit?: number;
  offset?: number;
  excludeIds?: string[];
  seed?: number;
};

export async function searchProducts(filters: ProductFilters = {}) {
  const { search, category, minPrice, maxPrice, sort, mode, limit = 50, offset = 0, excludeIds, seed } = filters;

  let where = ["p.status = 'active'"];
  const params: any[] = [];
  let paramIdx = 1;

  if (search) {
    where.push(`(p.search_document @@ to_tsquery('simple', $${paramIdx}))`);
    params.push(search.trim().split(/\s+/).join(" | "));
    paramIdx++;
  }

  if (category) {
    where.push(`p.category ILIKE $${paramIdx}`);
    params.push(`%${category}%`);
    paramIdx++;
  }

  if (minPrice != null) {
    where.push(`p.price_cents >= $${paramIdx}`);
    params.push(Math.round(minPrice * 100));
    paramIdx++;
  }
  if (maxPrice != null) {
    where.push(`p.price_cents <= $${paramIdx}`);
    params.push(Math.round(maxPrice * 100));
    paramIdx++;
  }

  if (mode === "video") {
    where.push("(p.metadata->>'has_video')::boolean = true");
  }

  if (excludeIds?.length) {
    const placeholders = excludeIds.map((_, i) => `$${paramIdx + i}`).join(",");
    where.push(`p.id NOT IN (${placeholders})`);
    params.push(...excludeIds);
    paramIdx += excludeIds.length;
  }

  let orderBy = "p.created_at DESC";
  if (sort === "price_asc") orderBy = "p.price_cents ASC NULLS LAST";
  if (sort === "price_desc") orderBy = "p.price_cents DESC NULLS LAST";
  if (sort === "popular" || mode === "trending") orderBy = "(p.metadata->>'orders_count')::int DESC NULLS LAST";
  if (mode === "deals") orderBy = "p.price_cents ASC NULLS LAST";
  if (mode === "feed") orderBy = "(p.metadata->>'has_video') DESC, p.created_at DESC";

  const sql = `
    SELECT p.*
    FROM marketplace_products p
    WHERE ${where.join(" AND ")}
    ORDER BY ${orderBy}
    LIMIT $${paramIdx} OFFSET $${paramIdx + 1}`;
  params.push(Math.min(limit, 200), offset);

  const { rows } = await dbQuery(sql, params);
  const products = rows.map((r: any) => transformProduct(r));

  const countSql = `
    SELECT COUNT(*) as total
    FROM marketplace_products p
    WHERE ${where.join(" AND ")}`;
  const { rows: countRows } = await dbQuery(countSql, params.slice(0, -2));
  const total = parseInt(countRows[0]?.total || "0");

  return { products, total, offset, limit };
}

export async function getProductById(id: string) {
  const { rows } = await dbQuery(
    `SELECT * FROM marketplace_products WHERE id = $1`, [id]
  );
  if (rows.length === 0) return null;
  return transformProduct(rows[0]);
}

export async function getCheckoutProductById(id: string) {
  const { rows } = await dbQuery(
    `SELECT * FROM marketplace_products WHERE id = $1`, [id]
  );
  if (rows.length === 0) return null;

  const row = rows[0];
  const priceCents = Number(row.price_cents);
  if (!Number.isFinite(priceCents) || priceCents <= 0) {
    console.warn(`[Checkout] Product ${id} has invalid price_cents: ${row.price_cents}`);
    return null;
  }

  const images: string[] = [];
  if (row.image_url) images.push(row.image_url);
  if (row.metadata?.images && Array.isArray(row.metadata.images)) {
    images.push(...row.metadata.images.filter((img: string) => img && img !== row.image_url).slice(0, 3));
  }

  return {
    productId: String(row.id),
    aeProductId: String(row.supplier_product_id),
    title: row.title,
    price: priceCents / 100,
    oldPrice: Number(row.compare_at_price_cents) > 0 ? Number(row.compare_at_price_cents) / 100 : Math.round((priceCents / 100) * 1.3),
    image: images[0] || undefined,
    category: cleanCategoryLabel(row.category, "General"),
  };
}

export async function getCategories() {
  const { rows } = await dbQuery(`
    SELECT category as name, count(*) as count
    FROM marketplace_products
    WHERE status = 'active'
    GROUP BY category
    ORDER BY count DESC
  `);
  return rows.map((r: any) => ({
    id: r.name,
    name: r.name,
    count: parseInt(r.count)
  }));
}
